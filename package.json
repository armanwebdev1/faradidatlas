{
  "name": "faradidatlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "payload generate:importmap && npx tsx scripts/push-schema.ts && next build --webpack",
    "dev": "next dev --webpack",
    "lint": "eslint .",
    "start": "next start",
    "typecheck": "tsc --noEmit --pretty false",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "audit": "npm audit --audit-level=moderate",
    "production:check": "npm run verify && npm run audit",
    "payload": "payload",
    "payload:generate": "payload generate:types",
    "payload:migrate": "payload migrate",
    "payload:migrate:fresh": "payload migrate:fresh",
    "migrate": "tsx scripts/migrate.ts",
    "test": "playwright test",
    "test:visual": "playwright test --update-snapshots"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.85.2",
    "@payloadcms/live-preview-react": "3.85.2",
    "@payloadcms/next": "^3.85.2",
    "@payloadcms/plugin-redirects": "^3.85.2",
    "@payloadcms/plugin-seo": "^3.85.2",
    "@payloadcms/richtext-lexical": "^3.85.2",
    "@payloadcms/storage-vercel-blob": "^3.85.2",
    "@payloadcms/translations": "^3.85.2",
    "@radix-ui/react-slot": "1.1.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "gsap": "3.14.2",
    "lucide-react": "^0.454.0",
    "next": "^16.2.7",
    "payload": "^3.85.2",
    "pg": "^8.22.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^6.12.4",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.0.10",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "tsx": "^4.23.0",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
