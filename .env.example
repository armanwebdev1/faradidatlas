NEXT_PUBLIC_SITE_URL=https://faradidatlas.com

# Keep forms frontend-only until email/backend setup is ready.
NEXT_PUBLIC_ENABLE_BACKEND=false

# Resend email delivery
RESEND_API_KEY=
LEAD_FROM_EMAIL=Faradid Atlas <noreply@faradidatlas.com>
LEAD_TO_EMAIL=ahmadpour.web@gmail.com,info.faradidco@gmail.com
CAREERS_TO_EMAIL=ahmadpour.web@gmail.com,info.faradidco@gmail.com

# Optional bot protection. If set, forms may submit a Turnstile token.
TURNSTILE_SECRET_KEY=

# Payload CMS
DATABASE_URI=postgres://user:password@localhost:5432/faradidatlas
PAYLOAD_SECRET=your-secret-key-here
WEBHOOK_SECRET=your-webhook-secret-here
